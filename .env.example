# Artificial Analysis API v2 (https://artificialanalysis.ai/api/v2/...)
# Free tier is rate-limited (~100 req/24h, UNVERIFIED) — snapshots are mandatory.
ARTIFICIAL_ANALYSIS_API_KEY=

# Registry database. Postgres in production; SQLite fallback for dev.
MODEL_ROUTER_DATABASE_URL=postgresql+psycopg://router:router@localhost:5432/model_router
# MODEL_ROUTER_DATABASE_URL=sqlite:///./model_router.sqlite

# Where raw source snapshots are cached (never call upstream without a cache).
MODEL_ROUTER_DATA_DIR=./data
