# gentle-ai-model-router central configuration (example).
# Copy to router.yaml and adjust. All sections consumed by Phase 1+ code.

data_sources:
  artificial_analysis:
    base_url: "https://artificialanalysis.ai"
    endpoints:
      models: "/api/v2/language/models"
      models_free: "/api/v2/language/models/free"
    # Responses are snapshotted verbatim under data/snapshots/ before use.
    snapshot_dir: "data/snapshots/artificial-analysis"
    cache_ttl_hours: 24
  lmarena:
    dataset: "lmarena-ai/leaderboard-dataset"
    splits: ["latest"]          # "full" for history
    # Verified configs (2026-09-18). NOTE: no "math" config exists.
    categories: ["text", "webdev", "agent", "search"]
  local_discovery:
    opencode_config: "~/.config/opencode/opencode.json"
    opencode_variants_cache: "~/.gentle-ai/cache/model-variants.json"
    pi_models: "~/.pi/gentle-ai/models.json"
    codex_profiles_dir: "~/.codex"
    claude_agents_dir: "~/.claude/agents"
  gentle_telemetry:
    enabled: true
    base_url: "https://gentlemanprogramming.com/data/datasets"
    endpoints:
      - "runtime-agent-models.csv"
      - "runtime-by-model.csv"
      - "runtime-by-effort.csv"
    timeout_seconds: 30.0

registry:
  database_url: "postgresql+psycopg://router:router@localhost:5432/model_router"
  sqlite_fallback: "sqlite:///./model_router.sqlite"   # dev only

# Per-phase quality floors: P(success | phase, candidate) must stay >= floor.
# 11 SDD phases exist in Gentle AI (incl. init/research/archive/onboard).
phase_thresholds:
  sdd-explore: { min_success_rate: 0.80 }
  sdd-propose: { min_success_rate: 0.80 }
  sdd-spec:    { min_success_rate: 0.85 }
  sdd-design:  { min_success_rate: 0.85 }
  sdd-tasks:   { min_success_rate: 0.85 }
  sdd-apply:   { min_success_rate: 0.90 }
  sdd-verify:  { min_success_rate: 0.90 }

token_weights:
  # Objective: minimize tokens_per_success. Weights let reasoning/cache
  # tokens count differently per deployment contract (cache reads are cheaper).
  input: 1.0
  output: 1.0
  reasoning: 1.0
  cache_read: 0.1
  cache_write: 0.5

escalation:
  max_escalations_per_run: 2
  cooldown_minutes: 30
  # Ordered ladder per phase: start cheap, climb only when the quality floor
  # is at risk. Model ids are registry keys, filled in Phase 1.
  ladders:
    sdd-explore: []
    sdd-apply: []

# ---------------------------------------------------------------------------
# Phase 1b: deterministic baseline policy
# ---------------------------------------------------------------------------

# Per-phase policy for the baseline ranker (router/policy.py). Keys accept the
# bare phase name ("explore") or "sdd-explore". threshold_quality is the
# minimum-sufficient-effort floor; weights are benchmark keys (with optional
# ":category" suffix, e.g. lmarena_elo:text) min-max normalized across the
# candidate set.
phases:
  init:      { threshold_quality: 0.60, weights: { "telemetry_success_rate:sdd-init": 1.0 } }
  explore:   { threshold_quality: 0.60, weights: { "telemetry_success_rate:explore": 1.0, "telemetry_success_rate:sdd-explore": 1.0, "lmarena_elo:text": 0.5, "artificial_analysis_intelligence_index": 0.3 } }
  research:  { threshold_quality: 0.65, weights: { "telemetry_success_rate:sdd-research": 1.0 } }
  propose:   { threshold_quality: 0.75, weights: { "telemetry_success_rate:sdd-propose": 1.0 } }
  spec:      { threshold_quality: 0.80, weights: { "telemetry_success_rate:sdd-spec": 1.0 } }
  design:    { threshold_quality: 0.85, weights: { "telemetry_success_rate:sdd-design": 1.0, "artificial_analysis_intelligence_index": 0.8, "lmarena_elo:webdev": 0.5 } }
  tasks:     { threshold_quality: 0.70, weights: { "telemetry_success_rate:sdd-tasks": 1.0 } }
  apply:     { threshold_quality: 0.75, weights: { "telemetry_success_rate:sdd-apply": 1.0, "artificial_analysis_intelligence_index": 0.5 } }
  verify:    { threshold_quality: 0.80, weights: { "telemetry_success_rate:sdd-verify": 1.0, "telemetry_success_rate:verify": 1.0, "artificial_analysis_intelligence_index": 0.5 } }
  archive:   { threshold_quality: 0.60, weights: { "telemetry_success_rate:sdd-archive": 1.0 } }
  onboard:   { threshold_quality: 0.60 }

policy:
  flat_prior: 0.5            # prior when a candidate has no benchmark rows
  effort_ceiling: 0.98       # quality asymptote at max effort
  # Diminishing-returns gain table: quality = prior + (ceiling - prior) * gain.
  # (Chosen over 1 - e^{-k*level}: auditable per level, no calibration const.)
  effort_quality_gain:
    "off": 0.0
    "minimal": 0.2
    "low": 0.4
    "medium": 0.6
    "high": 0.75
    "xhigh": 0.85
    "max": 0.92
  # Superlinear token cost per effort (cost grows faster than quality).
  effort_token_multiplier:
    "off": 1.0
    "minimal": 1.15
    "low": 1.4
    "medium": 1.9
    "high": 2.6
    "xhigh": 3.5
    "max": 5.0
  lambda_price: 1.0          # score penalty per estimated USD
  lambda_latency: 0.0        # off until the registry carries tps data
  speed_benchmark: null      # optional benchmark key used as 1/tps proxy
  base_tokens: 10000         # token estimate when no task context is given
  output_fraction: 0.3       # share of estimated tokens priced as output
  default_input_price: 5.0   # USD/1M when the registry has no price row
  default_output_price: 15.0
  top_k: 5

# OpenCode write adapter (integration/opencode_adapter.py).
integrate:
  # model-variants caches used to clamp efforts DOWN to supported levels
  # (telemetry-probe.md §2.2: the TUI deletes unknown efforts).
  variants_cache_v1: "~/.gentle-ai/cache/model-variants.json"
  variants_cache_v2_dir: "~/.gentle-ai/cache/opencode-v2"
  backup: true               # write <path>.router-backup-<ts> before first write

# Constrained bandit over shim rewards (router/bandit.py). Consumed by the
# /route bandit consult and by `router thresholds` (its evidence bar doubles
# as the tuner's min_executions). Invalid values fail closed at load time.
bandit:
  exploration_weight: 1.0      # UCB bonus multiplier (>= 0)
  min_executions_before_exploit: 3  # per-phase cold-start bar (>= 1)
  seed: 42                     # reserved for seeded tie-breaking
  quality_floor: 0.5           # minimum success_rate to stay UCB-eligible
  # phases:                    # optional per-phase quality_floor overrides
  #   apply: 0.9

# Telemetry shim (integration/telemetry_shim.py): local-only store.
shim:
  database_filename: "telemetry.sqlite"

# ModernBERT ranker training (training/train.py). Heavy deps live in the
# [train] extra; these settings are consumed by `router train`.
training:
  model_name: "answerdotai/ModernBERT-base" # override with a tiny config in tests
  objective: "pairwise" # pointwise | pairwise (listwise: future work)
  output_dir: "models/modernbert-router"
  learning_rate: 0.00002
  epochs: 2
  batch_size: 8
  max_length: 512
  seed: 42
  device: "auto"                            # auto = cuda when available, else cpu

evaluation:
  batch_size: 64                            # candidates scored per forward pass
  device: "auto"                            # ranker scoring device (baselines-only ignores both)

# FastAPI server (api/server.py), consumed by `router serve`.
api:
  host: "127.0.0.1"            # local-first: bind localhost unless you know better
  port: 8377
  route_path: "/route"
  # Telemetry shim SQLite for persisted /route decisions. Null falls back to
  # data_dir/telemetry.sqlite (RouterConfig.telemetry_url).
  shim_db_path: null

logging:
  level: "INFO"
  provenance: true   # every pick logs ranker score, prior/telemetry weight, constraint check
